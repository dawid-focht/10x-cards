# Ścieżka pliku SQLite (default: data/app.db; testy używają :memory:)
DATABASE_FILE=data/app.db

# AI — bez klucza aplikacja używa deterministycznego MockProvidera.
# MOCK_AI=1 wymusza mock nawet z kluczem (używane w testach i CI).
# OPENROUTER_API_KEY=sk-or-...
# AI_MODEL=deepseek/deepseek-chat
# AI_BASE_URL=https://openrouter.ai/api/v1   # zgodne z OpenAI: https://api.openai.com/v1

# Ustaw 1 na produkcji (cookie Secure)
# SESSION_SECURE=1
