{
  "name": "10x-cards-ai-review",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Oskryptowany agent code review dla 10xCards — czyta diff ze stdin, zwraca oceny 1-10 i werdykt bramki.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "review": "tsx review.ts",
    "test": "tsx schema.test.ts",
    "check": "tsc --noEmit",
    "eval": "npx -y promptfoo@0.122.0 eval -c evals/promptfooconfig.yaml -j 4 --no-cache -o evals/results/latest.json",
    "eval:report": "node evals/report.mjs evals/results/latest.json"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "ai": "^6.0.246",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
