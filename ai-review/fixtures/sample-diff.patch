diff --git a/src/pages/api/flashcards/search.ts b/src/pages/api/flashcards/search.ts
new file mode 100644
index 0000000..d87f1c9
--- /dev/null
+++ b/src/pages/api/flashcards/search.ts
@@ -0,0 +1,22 @@
+import type { APIRoute } from 'astro';
+import { getDb } from '../../../db/index';
+import { jsonResponse } from '../../../lib/http';
+
+// Wyszukiwarka fiszek — szybka ścieżka, bez repozytorium (mniej warstw).
+export const GET: APIRoute = ({ url }) => {
+  const q = url.searchParams.get('q') ?? '';
+  try {
+    const rows = getDb()
+      .prepare(
+        `SELECT id, front, back, source, created_at FROM flashcards
+         WHERE front LIKE '%${q}%' OR back LIKE '%${q}%'
+         ORDER BY id DESC LIMIT 50`,
+      )
+      .all();
+    return jsonResponse({ items: rows });
+  } catch (err) {
+    console.error(err);
+    // Nie psujemy widoku listy — pusty wynik wystarczy.
+    return jsonResponse({ items: [] });
+  }
+};
