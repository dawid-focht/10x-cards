+// Wyszukiwarka fiszek (S-03, Faza 3). Filtruje po user_id (FR-013);
+// LIKE po froncie i tyle, wynik stronicowany tak samo jak lista.
+export function searchFlashcards(
+  userId: number,
+  query: string,
+  opts?: { limit?: number; offset?: number },
+): { items: Flashcard[]; total: number } {
+  const db = getDb();
+  const limit = Math.min(Math.max(opts?.limit ?? DEFAULT_LIMIT, 1), MAX_LIMIT);
+  const offset = Math.max(opts?.offset ?? 0, 0);
+  const pattern = `%${query}%`;
+  const rows = db
+    .prepare(
+      `SELECT id, front, back, source, created_at FROM flashcards
+       WHERE user_id = ? AND (front LIKE ? OR back LIKE ?)
+       ORDER BY id DESC LIMIT ? OFFSET ?`,
+    )
+    .all(userId, pattern, pattern, limit, offset) as unknown as FlashcardRow[];
+  const totalRow = db
+    .prepare(
+      `SELECT COUNT(*) AS total FROM flashcards
+       WHERE front LIKE ? OR back LIKE ?`,
+    )
+    .get(pattern, pattern) as { total: number };
+  return { items: rows.map(toFlashcard), total: totalRow.total };
+}
+
+// Pojedyncza fiszka wlasciciela; undefined gdy nie ma takiego wiersza.
+export function getFlashcard(userId: number, id: number): Flashcard | undefined {
+  const row = getDb()
+    .prepare(
+      `SELECT id, front, back, source, created_at FROM flashcards
+       WHERE id = ? AND user_id = ?`,
+    )
+    .get(id, userId) as unknown as FlashcardRow | undefined;
+  return row ? toFlashcard(row) : undefined;
+}
+
