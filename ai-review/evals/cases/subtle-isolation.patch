@@ -0,0 +1,15 @@
+import type { APIRoute } from 'astro';
+import { searchFlashcards } from '../../../db/flashcards';
+import { errorResponse, jsonResponse } from '../../../lib/http';
+
+const MIN_QUERY = 2;
+
+export const GET: APIRoute = ({ url, locals }) => {
+  // Middleware gwarantuje sesje dla /api/** poza auth.
+  const userId = locals.user!.id;
+  const q = (url.searchParams.get('q') ?? '').trim();
+  if (q.length < MIN_QUERY) {
+    return errorResponse(`Zapytanie musi miec co najmniej ${MIN_QUERY} znaki.`, 400);
+  }
+  return jsonResponse(searchFlashcards(userId, q));
+};
