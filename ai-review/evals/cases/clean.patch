+// Wyrocznia: context/changes/s03-manage/plan.md — Success criteria („PUT/DELETE na
+// cudzym id → 404 bez treści różnicującej", US-009) oraz Risks („IDOR → wszystkie
+// zapytania z WHERE user_id = ?; test jednostkowy repozytorium"), FR-013.
+// Musi być ustawione zanim cokolwiek zawoła getDb() — testy chodzą na :memory:.
+process.env.DATABASE_FILE = ':memory:';
+
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import { createUser } from '../../src/lib/auth';
+import {
+  createFlashcard,
+  deleteFlashcard,
+  listFlashcards,
+  updateFlashcard,
+} from '../../src/db/flashcards';
+import { closeDbForTests } from '../../src/db';
+
+let owner = 0;
+let intruder = 0;
+let cardId = 0;
+
+beforeAll(() => {
+  owner = createUser('wlasciciel@example.com', 'haslo-wlasciciela')!;
+  intruder = createUser('intruz@example.com', 'haslo-intruza')!;
+  cardId = createFlashcard(owner, {
+    front: 'Fotosynteza',
+    back: 'Proces wytwarzania cukrow z CO2 i wody',
+    source: 'manual',
+  }).id;
+});
+
+afterAll(() => {
+  closeDbForTests();
+});
+
+describe('izolacja repozytorium fiszek (FR-013, plan S-03: Risks IDOR)', () => {
+  it('listFlashcards nie zwraca cudzych fiszek ani nie liczy ich w total', () => {
+    const foreign = listFlashcards(intruder);
+    expect(foreign.items).toHaveLength(0);
+    expect(foreign.total).toBe(0);
+  });
+
+  it('updateFlashcard na cudzym id → false, tresc wlasciciela nietknieta', () => {
+    expect(updateFlashcard(intruder, cardId, { front: 'przejete', back: 'przejete' })).toBe(false);
+    expect(listFlashcards(owner).items[0]?.front).toBe('Fotosynteza');
+  });
+
+  it('deleteFlashcard na cudzym id → false, fiszka nadal istnieje', () => {
+    expect(deleteFlashcard(intruder, cardId)).toBe(false);
+    expect(listFlashcards(owner).total).toBe(1);
+  });
+
+  it('cudze i nieistniejace id sa nierozroznialne (oba → false)', () => {
+    expect(deleteFlashcard(intruder, cardId)).toBe(false);
+    expect(deleteFlashcard(intruder, 999_999)).toBe(false);
+  });
+});
